<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <FormatToolDir>$(MSBuildSDKsPath)/../DotnetTools/dotnet-format</FormatToolDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(FormatToolDir)/*.dll" />
    <Reference Include="$(FormatToolDir)/BuildHost-netcore/Microsoft.Build.Locator.dll" />
    <Content Include="$(FormatToolDir)/BuildHost-netcore/**/*" Link="BuildHost-netcore/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/*.cs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireSdkAnalysisTools" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FormatToolDir)/Microsoft.CodeAnalysis.Workspaces.dll')" Text="The selected .NET SDK must include DotnetTools/dotnet-format source-analysis assemblies. Install the SDK selected by global.json; the audit cannot run without them." />
  </Target>
</Project>
