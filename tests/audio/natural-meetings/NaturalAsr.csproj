<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lokad.Onnx"><HintPath>$(FrozenProductDirectory)/Lokad.Onnx.dll</HintPath></Reference>
    <Reference Include="Lokad.Onnx.Data"><HintPath>$(FrozenProductDirectory)/Lokad.Onnx.Data.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(FrozenProductDirectory)/Google.Protobuf.dll</HintPath></Reference>
    <Reference Include="FastBertTokenizer"><HintPath>$(FrozenProductDirectory)/FastBertTokenizer.dll</HintPath></Reference>
    <Reference Include="Lokad.Tokenizers"><HintPath>$(FrozenProductDirectory)/Lokad.Tokenizers.dll</HintPath></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(FrozenProductDirectory)/SixLabors.ImageSharp.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenProduct" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FrozenProductDirectory)'==''" Text="Supply verified immutable product assemblies." />
  </Target>
</Project>
