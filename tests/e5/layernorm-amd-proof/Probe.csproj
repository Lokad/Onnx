<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>LayerNormAmdProof</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FrozenSourceDirectory)/Proof.cs" Link="Proof.cs" />
    <Compile Include="$(FrozenSourceDirectory)/Kernels.cs" Link="Kernels.cs" />
    <Reference Include="Lokad.Onnx"><HintPath>$(FrozenProductDirectory)/Lokad.Onnx.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(FrozenProductDirectory)/Google.Protobuf.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="Frozen" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FrozenProductDirectory)'=='' or '$(FrozenSourceDirectory)'==''" Text="Supply frozen product and proof/kernel source directories." />
  </Target>
</Project>
