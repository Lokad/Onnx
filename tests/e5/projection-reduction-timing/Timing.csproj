<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lokad.Onnx"><HintPath>$(FrozenCorePath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenCore" BeforeTargets="ResolveReferences"><Error Condition="'$(FrozenCorePath)'==''" Text="Supply FrozenCorePath."/></Target>
</Project>
