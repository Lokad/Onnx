<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup><Compile Include="Program.cs"/><Compile Include="Measurement.cs"/><Compile Include="$(KernelSourceDirectory)/*.cs"/><Reference Include="Lokad.Onnx"><HintPath>$(FrozenCorePath)</HintPath></Reference></ItemGroup>
  <Target Name="RequireFrozenInputs" BeforeTargets="ResolveReferences"><Error Condition="'$(FrozenCorePath)'=='' or '$(KernelSourceDirectory)'==''" Text="Supply FrozenCorePath and KernelSourceDirectory."/></Target>
</Project>
