<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lokad.Onnx"><HintPath>$(FrozenProductDirectory)/Lokad.Onnx.dll</HintPath></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(FrozenProductDirectory)/Google.Protobuf.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenProduct" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FrozenProductDirectory)'==''" Text="Supply FrozenProductDirectory."/>
  </Target>
</Project>
