+                *(Vector512<float>*)(output + ((oc / lanes + 2) * spatial + y * ow + col + 3) * lanes) = a32;
+                *(Vector512<float>*)(output + ((oc / lanes + 3) * spatial + y * ow + col + 3) * lanes) = a33;
