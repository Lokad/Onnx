    <None Update="fixtures\if-ort.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\lstm-ort.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\clip-ort.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\normalization-ort.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\whisper-frontend.json" CopyToOutputDirectory="PreserveNewest" />
