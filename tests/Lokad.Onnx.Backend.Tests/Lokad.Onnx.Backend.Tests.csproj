  <ItemGroup>
    <Compile Include="..\Shared\TestSupport.cs" Link="TestSupport.cs" />
    <Compile Include="..\Shared\NpySupport.cs" Link="NpySupport.cs" />
    <Compile Include="..\Lokad.Onnx.Bench\VoiceModelCases.cs" Link="VoiceModelCases.cs" />
