<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Lokad.Onnx.PackageConsumer</AssemblyName>
    <CorePackageVersion Condition="'$(CorePackageVersion)' == ''">0.4.0</CorePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lokad.Onnx" Version="[$(CorePackageVersion)]" />
  </ItemGroup>
</Project>
